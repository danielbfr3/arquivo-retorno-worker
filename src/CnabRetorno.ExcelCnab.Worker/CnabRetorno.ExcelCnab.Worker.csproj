<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cnab-excel-cnab-worker</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CnabRetorno.Core\CnabRetorno.Core.csproj" />
    <ProjectReference Include="..\CnabRetorno.Common\CnabRetorno.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Cronos" Version="0.10.0" />
    <!--
      Grava a linha do arquivo em Cobranca.Arquivo (base CASH_COBRANCA) e
      lê a razão social do cliente na base de adesão, além da nova tabela
      Cobranca.DocumentoDados (numero de documento + JSON de dados).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!--
      Abre e preenche a planilha em memória (Planilha/PreenchedorPlanilhaExcel.cs)
      antes de repassá-la ao conversor. Único lugar do worker que conhece
      esta biblioteca — MIT, sem restrição de uso comercial (ao contrário
      do EPPlus >v5). Só lê/grava .xlsx (OOXML); não abre .xls.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
</Project>
