{
  "Worker": {
    "Modo": "Loop",
    "Cron": "*/15 * * * *"
  },
  "Pipeline": {
    "MaxArquivosConcorrentes": 8
  },
  "Origem": {
    "_comentario": "Localmente um diretório; em hml/prd o ponto de montagem do compartilhamento SMB no pod.",
    "Pasta": "/data/planilhas/entrada",
    "PastaBackup": "Backup",
    "PastaQuarentena": "Quarentena",
    "SegundosEstabilidade": 30
  },
  "Nomenclatura": {
    "_comentario": "Máscara do nome do arquivo, sem extensão. O token {cnpj} aceita o documento com ou sem pontuação e é normalizado pra 14 dígitos.",
    "Mascara": "Simplificado_{cnpj}",
    "Extensoes": [ ".xlsx", ".xls" ]
  },
  "RegistroArquivo": {
    "AppId": "cash-cobranca",
    "CriadoPor": "arquivo-excel-cnab-worker",
    "DescricaoProduto": "Cobrança"
  },
  "Conversao": {
    "_comentario": "CampoMetadados é TODO(a-confirmar): nome do campo do multipart que leva o JSON com cnpj e razão social.",
    "AppId": "cash-cobranca",
    "Pipeline": "excel-cnab",
    "CampoMetadados": "metadata"
  },
  "LayoutConversaoApi": {
    "BaseUrl": "https://TODO-confirmar/layout-conversao-api",
    "Timeout": "00:02:00"
  },
  "ConnectionStrings": {
    "Cobranca": "Server=localhost;Database=CASH_COBRANCA;User Id=worker;Password=dev;TrustServerCertificate=True",
    "Adesao": "Server=localhost;Database=ASA_CASH_ADESAO;User Id=worker;Password=dev;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
