<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Infra implementa contratos do domínio (ILayoutConversaoApiClient) —
      a dependência vai de Common pra Core, nunca o contrário: Core não
      referencia nada.
    -->
    <ProjectReference Include="..\CnabRetorno.Core\CnabRetorno.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Sem mensageria: este worker não consome fila — ele entrega a planilha
      ao conversor assíncrono e termina no aceite; quem trata a conclusão é
      outro worker do ecossistema. Se um consumidor de fila passar a
      existir, ele nasce aqui (Common), com todo nome de fila vindo de
      configuração, nunca literal em código.

      Sem SDK de storage aqui: as cópias no Gestor de Arquivos e no bucket
      são um recurso destacável, autocontido em
      CnabRetorno.ExcelCnab.Worker/Armazenamento/ — inclusive o
      PackageReference do AWSSDK.S3, que sai junto se ele for removido.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
</Project>
