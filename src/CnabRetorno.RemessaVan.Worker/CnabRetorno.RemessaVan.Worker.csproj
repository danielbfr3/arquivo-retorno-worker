<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cnab-remessa-van-worker</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CnabRetorno.Core\CnabRetorno.Core.csproj" />
    <ProjectReference Include="..\CnabRetorno.Common\CnabRetorno.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Cronos" Version="0.10.0" />
    <!--
      Grava a linha do arquivo de remessa em Cobranca.Arquivo e lê o
      ContaHeader do cliente em Cobranca.Parametro (base CASH_COBRANCA).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!--
      Só pro modo de storage "S3" (Storage:Modo). O modo padrão é
      "GestorArquivos" (presigned URL), que não usa SDK nenhum — ver
      Storage/ArmazenamentoOptions.cs sobre por que as duas versões existem.
    -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.6" />
  </ItemGroup>
</Project>
